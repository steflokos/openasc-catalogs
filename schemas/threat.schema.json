{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ThreatSchema",
    "type": "object",
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^T\\.\\d{2}(\\.[1-9]\\d*)*$",
            "description": "Hierarchical ID. Base: T.01. Refinements: T.01.1, T.01.2.1, etc."
        },
        "name": {
            "type": "string",
            "description": "Short name or label of the threat, e.g., 'Spoofing'"
        },
        "description": {
            "type": "string",
            "description": "Detailed description of the threat"
        },
        "metadata": {
            "type": "array",
            "description": "Curated engineering metadata. Represents the exact technologies, protocols, and hardware targeted. Used for AI context injection and UI filtering.",
            "items": {
                "type": "string",
                "enum": [
                    "CAN / CAN-FD / CAN-XL",
                    "Automotive Ethernet",
                    "LIN",
                    "FlexRay",
                    "SerDes",
                    "PCIe",
                    "SPI / I2C / I3C",
                    "UART / USART",
                    "CXPI",
                    "SENT / PSI5",
                    "TSN / AVB (Time-Sensitive Networking)",
                    "Cellular",
                    "Wi-Fi",
                    "Bluetooth / BLE",
                    "UWB",
                    "NFC / RFID",
                    "GNSS",
                    "LF / RF",
                    "V2X",
                    "Satellite",
                    "mmWave",
                    "RKE / PEPS (Keyless Entry)",
                    "UDS",
                    "DoIP",
                    "SOME/IP",
                    "DDS",
                    "MQTT / AMQP",
                    "XCP / CCP",
                    "J1939 / FMS",
                    "ISO 15118 / OCPP",
                    "gRPC / REST",
                    "LWM2M / OMA-DM",
                    "OTA / SOTA / FOTA",
                    "OBD-II",
                    "JTAG / cJTAG",
                    "SWD",
                    "USB",
                    "HDMI / DisplayPort",
                    "Audio Jacks / A2B",
                    "EVSE Plug / Wireless Charging",
                    "Trailer Socket",
                    "Media Slots",
                    "Diagnostic Pads",
                    "MCU",
                    "MPU",
                    "SoC",
                    "HPC / Zonal Controller",
                    "GPU / NPU",
                    "Sensor / Actuator",
                    "Transceiver / PHY",
                    "Flash / RAM / EEPROM",
                    "FPGA",
                    "eFuse / OTP",
                    "LiDAR / Radar / Camera",
                    "RTOS",
                    "HLOS",
                    "Hypervisor",
                    "Container",
                    "Bootloader",
                    "Middleware",
                    "App / Service",
                    "Kernel / Driver",
                    "ML Model / Weights",
                    "Config / Calibration File",
                    "SBOM / Software Composition",
                    "LLM / Conversational AI",
                    "HSM / SHE",
                    "TEE",
                    "TPM / SE",
                    "SecOC",
                    "MACsec / IPsec",
                    "TLS / DTLS",
                    "Secure Boot",
                    "TRNG / PRNG",
                    "PUF",
                    "IDS / IPS",
                    "OAuth / OIDC / SAML",
                    "PKI / Certificates",
                    "Symmetric Keys",
                    "Asymmetric Keys",
                    "Hashes",
                    "MAC / HMAC / CMAC",
                    "Digital Signatures",
                    "Nonces / IVs",
                    "Passwords / PINs",
                    "Tokens / API Keys",
                    "Seeds / RoT Data",
                    "Session Keys / Ephemeral Secrets"
                ]
            },
            "minItems": 1,
            "uniqueItems": true
        },
        "classificationModel": {
            "type": "string",
            "enum": [
                "STRIDE",
                "MITRE ATT&CK®"
            ],
            "description": "The threat classification model this threat belongs to"
        },
        "scalability": {
            "type": "string",
            "enum": [
                "Single Vehicle",
                "Limited Batch",
                "Fleet-Wide"
            ],
            "description": "The realistic breadth of exploitation this threat's mechanism supports, independent of any single company's actual fleet size. 'Single Vehicle': requires unique physical possession/access per target and cannot be trivially repeated at scale (e.g. hardware fault injection, JTAG probing). 'Limited Batch': bounded by a specific production run, hardware revision, regional configuration, or backend tenant/segment rather than either a single unit or the full fleet. 'Fleet-Wide': remotely or systemically replicable - the same exploit chain applies identically to every vehicle sharing the vulnerable design, firmware, or protocol, without repeating physical effort per unit. This is distinct from attackFeasibility, which rates attacker effort per instance, not how many vehicles a successful exploit reaches."
        },
        "threatActors": {
            "type": "array",
            "description": "The class(es) of threat actor realistically capable of and motivated to execute this threat - who, and why - as opposed to attackFeasibility (how hard) or scalability (how far it reaches). Deliberately excludes skill-tier labels like 'script kiddie': attacker sophistication is already captured by attackFeasibility's specialistExpertise/equipment components, so this field is about motivation and access relationship, not capability. Multiple values are expected on most threats.",
            "items": {
                "type": "string",
                "enum": [
                    "Nation-State / State-Sponsored",
                    "Organized Cybercrime",
                    "Hacktivist",
                    "Insider (Employee / Dealer / Supplier)",
                    "Vehicle Owner / Authorized User"
                ]
            },
            "minItems": 1,
            "uniqueItems": true
        },
        "source": {
            "type": "object",
            "description": "Source reference for the threat definition",
            "properties": {
                "name": {
                    "type": "string"
                },
                "url": {
                    "type": "string",
                    "format": "uri"
                }
            }
        },
        "notes": {
            "type": "string",
            "description": "Optional notes or comments for the threat."
        },
        "unitedNationsRegulation155": {
            "type": "array",
            "description": "List of applicable UN Regulation No. 155 threat categories",
            "items": {
                "type": "string",
                "enum": [
                    "1.1",
                    "1.2",
                    "1.3",
                    "2.1",
                    "3.1",
                    "3.2",
                    "3.3",
                    "3.4",
                    "3.5",
                    "4.1",
                    "4.2",
                    "5.1",
                    "5.2",
                    "5.3",
                    "5.4",
                    "5.5",
                    "6.1",
                    "6.2",
                    "6.3",
                    "7.1",
                    "7.2",
                    "8.1",
                    "8.2",
                    "9.1",
                    "10.1",
                    "11.1",
                    "11.2",
                    "11.3",
                    "11.4",
                    "12.1",
                    "12.2",
                    "12.3",
                    "12.4",
                    "13.1",
                    "15.1",
                    "15.2",
                    "16.1",
                    "16.2",
                    "16.3",
                    "17.1",
                    "18.1",
                    "18.2",
                    "18.3",
                    "19.1",
                    "19.2",
                    "19.3",
                    "20.1",
                    "20.2",
                    "20.3",
                    "20.4",
                    "20.5",
                    "21.1",
                    "22.2",
                    "23.1",
                    "24.1",
                    "25.1",
                    "25.2",
                    "26.1",
                    "26.2",
                    "26.3",
                    "27.1",
                    "28.1",
                    "28.2",
                    "29.1",
                    "29.2",
                    "30.1",
                    "30.2",
                    "30.3",
                    "31.1",
                    "32.1"
                ]
            }
        },
        "attackFeasibility": {
            "type": "object",
            "properties": {
                "attackPotential": {
                    "type": "object",
                    "properties": {
                        "elapsedTime": {
                            "$ref": "#/$defs/FeasibilityComponent"
                        },
                        "specialistExpertise": {
                            "$ref": "#/$defs/FeasibilityComponent"
                        },
                        "knowledgeOfTheItemOrComponent": {
                            "$ref": "#/$defs/FeasibilityComponent"
                        },
                        "windowOfOpportunity": {
                            "$ref": "#/$defs/FeasibilityComponent"
                        },
                        "equipment": {
                            "$ref": "#/$defs/FeasibilityComponent"
                        }
                    },
                    "required": [
                        "elapsedTime",
                        "specialistExpertise",
                        "knowledgeOfTheItemOrComponent",
                        "windowOfOpportunity",
                        "equipment"
                    ]
                }
            },
            "required": [
                "attackPotential"
            ]
        },
        "refines": {
            "type": "string",
            "pattern": "^T\\.\\d{2}(\\.[1-9]\\d*)*$",
            "description": "Must equal the parent prefix of id. Not enforced by scripts/validate.js (which performs schema-shape validation only, not cross-entry referential integrity) - maintainers are responsible for keeping this consistent with the id hierarchy."
        },
        "compromises": {
            "type": "array",
            "description": "List of security properties this threat compromises",
            "items": {
                "type": "string",
                "enum": [
                    "Confidentiality",
                    "Integrity",
                    "Availability",
                    "Authenticity",
                    "Non Repudiation"
                ]
            }
        },
        "requires": {
            "description": "The AND/OR capabilities required to execute this threat.",
            "anyOf": [
                {
                    "$ref": "#/$defs/LogicalCondition"
                },
                {
                    "$ref": "#/$defs/CapabilityNode"
                }
            ]
        },
        "grants": {
            "type": "array",
            "description": "The new capabilities this threat provides to the attacker upon success.",
            "items": {
                "$ref": "#/$defs/CapabilityNode"
            }
        }
    },
    "required": [
        "id",
        "name",
        "description",
        "classificationModel",
        "scalability",
        "threatActors",
        "attackFeasibility",
        "compromises"
    ],
    "$defs": {
        "FeasibilityComponent": {
            "type": "object",
            "properties": {
                "feasibility": {
                    "type": "string",
                    "pattern": "^(ET[0-4]|SE[0-3]|KoIC[0-3]|WoO[0-3]|Eq[0-3])$"
                },
                "rationale": {
                    "type": "string",
                    "default": ""
                }
            },
            "required": [
                "feasibility"
            ]
        },
        "CapabilityNode": {
            "type": "object",
            "properties": {
                "action": {
                    "type": "string",
                    "description": "The MECE-aligned attacker action.",
                    "enum": [
                        "Extract",
                        "Intercept",
                        "Modify",
                        "Inject",
                        "Disrupt",
                        "Execute",
                        "Elevate",
                        "Fault"
                    ]
                },
                "assetClass": {
                    "type": "string",
                    "description": "The MECE-aligned target class.",
                    "enum": [
                        "Compute",
                        "Memory",
                        "Peripheral",
                        "Network",
                        "Interface",
                        "Executable",
                        "Data",
                        "Crypto"
                    ]
                },
                "domain": {
                    "type": "string",
                    "description": "The vehicle primary domain. Includes the reserved wildcard \"*\" for capabilities not bound to a single domain (e.g. platform-level compute, root of trust, hypervisor). When capability nodes are compared, every \"*\" is first bound to the single domain being analysed (scoped resolution, see the README); action and assetClass always require an exact match.",
                    "enum": [
                        "Powertrain",
                        "Chassis",
                        "Body",
                        "Infotainment",
                        "ADAS",
                        "Telematics",
                        "External",
                        "Backend",
                        "*"
                    ]
                }
            },
            "required": [
                "action",
                "assetClass",
                "domain"
            ],
            "additionalProperties": false
        },
        "LogicalCondition": {
            "type": "object",
            "properties": {
                "AND": {
                    "type": "array",
                    "items": {
                        "anyOf": [
                            {
                                "$ref": "#/$defs/CapabilityNode"
                            },
                            {
                                "$ref": "#/$defs/LogicalCondition"
                            }
                        ]
                    },
                    "minItems": 1
                },
                "OR": {
                    "type": "array",
                    "items": {
                        "anyOf": [
                            {
                                "$ref": "#/$defs/CapabilityNode"
                            },
                            {
                                "$ref": "#/$defs/LogicalCondition"
                            }
                        ]
                    },
                    "minItems": 1
                }
            },
            "additionalProperties": false,
            "minProperties": 1,
            "maxProperties": 1
        }
    }
}