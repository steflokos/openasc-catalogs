{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "AssetSchema",
    "type": "object",
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^A\\.\\d{3}(\\.[1-9]\\d*)*$",
            "description": "Hierarchical ID. Base: A.001. Refinements: A.001.1, A.001.2.1, etc."
        },
        "name": {
            "type": "string",
            "description": "Name of the asset, e.g., 'BMS Master Firmware'"
        },
        "description": {
            "type": "string",
            "description": "Detailed description of the asset and its function within the system"
        },
        "class": {
            "type": "string",
            "description": "The functional security class of this asset. Maps symmetrically to the Attack Graph Asset Class.",
            "enum": [
                "Compute",
                "Memory",
                "Peripheral",
                "Network",
                "Interface",
                "Executable",
                "Data",
                "Crypto"
            ]
        },
        "domain": {
            "type": "string",
            "description": "The primary vehicle architectural domain. Includes the reserved wildcard \"*\" for assets not bound to a single domain (e.g. platform-level compute, root of trust, hypervisor). When this asset is matched against a threat's or control's CapabilityNode during graph traversal, \"*\" stands for the single domain being analysed (scoped resolution, see the README); the asset's class always requires an exact match against the node's assetClass.",
            "enum": [
                "Powertrain",
                "Chassis",
                "Body",
                "Infotainment",
                "ADAS",
                "Telematics",
                "External",
                "Backend",
                "*"
            ]
        },
        "metadata": {
            "type": "array",
            "description": "Curated engineering metadata. Represents the exact technologies, protocols, and hardware involved. Used for AI context injection and UI filtering.",
            "items": {
                "type": "string",
                "enum": [
                    "CAN / CAN-FD / CAN-XL",
                    "Automotive Ethernet",
                    "LIN",
                    "FlexRay",
                    "SerDes",
                    "PCIe",
                    "SPI / I2C / I3C",
                    "UART / USART",
                    "CXPI",
                    "SENT / PSI5",
                    "TSN / AVB (Time-Sensitive Networking)",
                    "Cellular",
                    "Wi-Fi",
                    "Bluetooth / BLE",
                    "UWB",
                    "NFC / RFID",
                    "GNSS",
                    "LF / RF",
                    "V2X",
                    "Satellite",
                    "mmWave",
                    "RKE / PEPS (Keyless Entry)",
                    "UDS",
                    "DoIP",
                    "SOME/IP",
                    "DDS",
                    "MQTT / AMQP",
                    "XCP / CCP",
                    "J1939 / FMS",
                    "ISO 15118 / OCPP",
                    "gRPC / REST",
                    "LWM2M / OMA-DM",
                    "OTA / SOTA / FOTA",
                    "OBD-II",
                    "JTAG / cJTAG",
                    "SWD",
                    "USB",
                    "HDMI / DisplayPort",
                    "Audio Jacks / A2B",
                    "EVSE Plug / Wireless Charging",
                    "Trailer Socket",
                    "Media Slots",
                    "Diagnostic Pads",
                    "MCU",
                    "MPU",
                    "SoC",
                    "HPC / Zonal Controller",
                    "GPU / NPU",
                    "Sensor / Actuator",
                    "Transceiver / PHY",
                    "Flash / RAM / EEPROM",
                    "FPGA",
                    "eFuse / OTP",
                    "LiDAR / Radar / Camera",
                    "RTOS",
                    "HLOS",
                    "Hypervisor",
                    "Container",
                    "Bootloader",
                    "Middleware",
                    "App / Service",
                    "Kernel / Driver",
                    "ML Model / Weights",
                    "Config / Calibration File",
                    "SBOM / Software Composition",
                    "LLM / Conversational AI",
                    "HSM / SHE",
                    "TEE",
                    "TPM / SE",
                    "SecOC",
                    "MACsec / IPsec",
                    "TLS / DTLS",
                    "Secure Boot",
                    "TRNG / PRNG",
                    "PUF",
                    "IDS / IPS",
                    "OAuth / OIDC / SAML",
                    "PKI / Certificates",
                    "Symmetric Keys",
                    "Asymmetric Keys",
                    "Hashes",
                    "MAC / HMAC / CMAC",
                    "Digital Signatures",
                    "Nonces / IVs",
                    "Passwords / PINs",
                    "Tokens / API Keys",
                    "Seeds / RoT Data",
                    "Session Keys / Ephemeral Secrets"
                ]
            },
            "minItems": 1,
            "uniqueItems": true
        },
        "partOf": {
            "type": "string",
            "pattern": "^A\\.\\d{3}(\\.[1-9]\\d*)*$",
            "description": "Reference to a parent asset that this asset belongs to or is hosted on. Not enforced by scripts/validate.js (which performs schema-shape validation only, not cross-entry referential integrity) - unlike refines on threats/controls, this is a free cross-reference and is not required to be a string-prefix of the asset's own id."
        },
        "notes": {
            "type": "string",
            "description": "Optional notes, comments, or references for the asset"
        },
        "cybersecurityProperties": {
            "type": "array",
            "description": "The CIAAN security properties (Confidentiality, Integrity, Availability, Authenticity, Non Repudiation - matching this field's own enum order) that must be protected for this asset",
            "items": {
                "type": "string",
                "enum": [
                    "Confidentiality",
                    "Integrity",
                    "Availability",
                    "Authenticity",
                    "Non Repudiation"
                ]
            },
            "minItems": 1,
            "uniqueItems": true
        },
        "impact": {
            "type": "object",
            "description": "Impact evaluation if the asset is compromised, categorized by stakeholder perspective",
            "properties": {
                "oem": {
                    "$ref": "#/$defs/StakeholderImpact"
                },
                "roadUser": {
                    "$ref": "#/$defs/StakeholderImpact"
                },
                "supplier": {
                    "$ref": "#/$defs/StakeholderImpact"
                }
            },
            "required": [
                "oem",
                "roadUser"
            ]
        }
    },
    "required": [
        "id",
        "name",
        "description",
        "class",
        "domain",
        "cybersecurityProperties",
        "impact"
    ],
    "$defs": {
        "StakeholderImpact": {
            "type": "object",
            "properties": {
                "safety": {
                    "$ref": "#/$defs/ImpactComponent"
                },
                "financial": {
                    "$ref": "#/$defs/ImpactComponent"
                },
                "operational": {
                    "$ref": "#/$defs/ImpactComponent"
                },
                "privacy": {
                    "$ref": "#/$defs/ImpactComponent"
                }
            },
            "required": [
                "safety",
                "financial",
                "operational",
                "privacy"
            ],
            "additionalProperties": false
        },
        "ImpactComponent": {
            "type": "object",
            "properties": {
                "level": {
                    "$ref": "#/$defs/ImpactLevel"
                },
                "rationale": {
                    "type": "string",
                    "description": "Optional explanation for why this specific impact rating was chosen",
                    "default": ""
                }
            },
            "required": [
                "level"
            ],
            "additionalProperties": false
        },
        "ImpactLevel": {
            "type": "string",
            "enum": [
                "Severe",
                "Major",
                "Moderate",
                "Negligible",
                "None"
            ],
            "description": "Standard ISO 21434 impact rating scale"
        }
    }
}